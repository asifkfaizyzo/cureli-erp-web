  // ── ADDED ─────────────────────────────────────────────────
  prescriptionRequests PrescriptionRequest[] @relation("RequestDeliveryAddress")
  // ──────────────────────────────────────────────────────────

  @@index([user_id])
  @@index([user_id, is_default])
