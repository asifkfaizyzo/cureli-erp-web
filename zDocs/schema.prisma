  valid_rows              Int   @default(0)
  imported_rows           Int   @default(0)
  skipped_rows            Int   @default(0)
  error_rows              Int   @default(0)
  new_medicines_created   Int   @default(0)
  existing_batches_merged Int   @default(0)
