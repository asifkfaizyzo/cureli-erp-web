{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-cureli",
      "dependsOn": [
        "Backend",
        "cAdmin",
        "ERP",
        "Landing",
        "Prisma tree",
        "Backend tree",
        "Landing tree",
        "ERP tree",
        "cAdmin tree",
        "Git"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Backend tree",
      "type": "shell",
      "command": "ls; cd src; tree /f; cd ..; cd prisma/schema; tree /f",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Prisma tree",
      "type": "shell",
      "command": "tree prisma\\schema /f; Write-Host ''; Write-Host 'prisma\\ (root files)' -ForegroundColor Cyan; Get-ChildItem prisma -File | Select-Object Name; Write-Host ''; Write-Host 'prisma\\migrations\\ (contents hidden)' -ForegroundColor Yellow; Write-Host ''; tree prisma\\seeds /f",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "ERP tree",
      "type": "shell",
      "command": "ls; cd src; tree /f",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/pharmacy-web"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "cAdmin tree",
      "type": "shell",
      "command": "ls; cd src; tree /f",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/cadmin-web"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Landing tree",
      "type": "shell",
      "command": "ls; cd src; tree /f",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/landing-web"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "cAdmin",
      "type": "shell",
