// backend/prisma/schema/pharmacy-payouts.prisma (do not remove this comment)

model PharmacyPayout {
  payout_id              String        @id @default(uuid()) @db.Uuid
  shop_id                String        @db.Uuid

  week_start             DateTime      @db.Date
  week_end               DateTime      @db.Date

  gross_amount           Decimal       @db.Decimal(12, 2)
  commission_amount      Decimal       @db.Decimal(12, 2)
  net_amount             Decimal       @db.Decimal(12, 2)

  status                 PayoutStatus  @default(DRAFT)
  payment_method         PayoutMethod  @default(MANUAL)
  is_finalized           Boolean       @default(false)
  finalized_at           DateTime?     @db.Timestamptz(6)

  breakdown_snapshot     Json?
  adjustments            Json          @default("[]")
  internal_notes         Json          @default("[]")

  manual_reference       String?       @db.VarChar(100)
  manual_notes           String?       @db.VarChar(500)
  manual_payment_date    DateTime?     @db.Date
  manual_bank_used       String?       @db.VarChar(100)

  bank_snapshot          Json?

  last_refreshed_at      DateTime?     @db.Timestamptz(6)
  refreshed_by           String?       @db.Uuid

  processed_by           String?       @db.Uuid
  processed_at           DateTime?     @db.Timestamptz(6)
  failed_reason          String?       @db.VarChar(500)

  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @updatedAt @db.Timestamptz(6)

  shop                   Shop                    @relation("ShopPharmacyPayouts", fields: [shop_id], references: [shop_id], onDelete: Cascade)
  orderLineItems         PharmacyPayoutOrder[]

  @@unique([shop_id, week_start], name: "pharmacy_week_unique")
  @@index([shop_id, status])
  @@index([status, created_at(sort: Desc)])
  @@index([week_start])
  @@map("pharmacy_payouts")
}

model PharmacyPayoutOrder {
  id                            String    @id @default(uuid()) @db.Uuid
  payout_id                     String    @db.Uuid
  order_id                      String    @unique @db.Uuid
  branch_id                     String    @db.Uuid
  order_number                  String    @db.VarChar(20)

  subtotal                      Decimal   @db.Decimal(10, 2)
  commission_rate_percent       Decimal   @db.Decimal(5, 2)
  commission_amount             Decimal   @db.Decimal(10, 2)
  pharmacy_earning              Decimal   @db.Decimal(10, 2)

  payment_status_at_calculation String    @db.VarChar(30)
  completed_at                  DateTime? @db.Timestamptz(6)

  created_at                    DateTime  @default(now()) @db.Timestamptz(6)

  payout                        PharmacyPayout     @relation(fields: [payout_id], references: [payout_id], onDelete: Cascade)
  order                         MarketplaceOrder   @relation(fields: [order_id], references: [order_id], onDelete: Restrict)

  @@index([payout_id])
  @@index([order_id])
  @@index([branch_id])
  @@map("pharmacy_payout_orders")
}