// backend/prisma/schema/loyalty-coupons.prisma (do not remove this comment)
// Loyalty & Coupons — Points, transactions, coupons

model LoyaltyConfig {
  config_id              String   @id @default(uuid()) @db.Uuid
  version                Int      @default(1)

  // Master toggle
  is_enabled             Boolean  @default(false)

  // Earning rules
  earn_rate_amount       Decimal  @default(100)    @db.Decimal(10, 2)  // ₹X per 1 point
  earn_basis             String   @default("SUBTOTAL") @db.VarChar(20)

  // Redemption rules
  redemption_value       Decimal  @default(1)      @db.Decimal(10, 2)  // 1 point = ₹Y
  min_redeem_points      Int      @default(50)
  min_order_amount       Decimal  @default(299)    @db.Decimal(10, 2)
  max_redeem_points      Int?
  max_redeem_percent     Decimal? @db.Decimal(5, 2)

  // Expiry
  points_expiry_days     Int?

  // Audit
  updated_by_cadmin_id   String?  @db.Uuid
  updated_by_name        String?  @db.VarChar(100)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("loyalty_config")
}

model LoyaltyTransaction {
  transaction_id     String                 @id @default(uuid()) @db.Uuid
  customer_id        String                 @db.Uuid
  type               LoyaltyTransactionType
  points             Int                                        // always positive; type indicates direction
  order_id           String?                @db.Uuid
  description        String                 @db.VarChar(300)
  balance_after      Int
  is_expired         Boolean                @default(false)     // set true by expiry cron
  expires_at         DateTime?              @db.Timestamptz(6)  // set on EARNED if expiry configured
  created_at         DateTime               @default(now()) @db.Timestamptz(6)

  customer           CureliMobileUser       @relation("CustomerLoyaltyTransactions", fields: [customer_id], references: [id], onDelete: Restrict)
  order              MarketplaceOrder?      @relation("OrderLoyaltyTransactions", fields: [order_id], references: [order_id], onDelete: SetNull)

  @@index([customer_id, created_at(sort: Desc)])
  @@index([customer_id, type])
  @@index([order_id])
  @@index([expires_at, is_expired])
  @@map("loyalty_transactions")
}

model Coupon {
  coupon_id            String     @id @default(uuid()) @db.Uuid
  code                 String     @unique @db.VarChar(50)
  description          String?    @db.VarChar(300)

  // Discount
  type                 CouponType
  value                Decimal    @db.Decimal(10, 2)    // ₹50 for FLAT, 20.00 for PERCENTAGE
  max_discount         Decimal?   @db.Decimal(10, 2)    // cap for PERCENTAGE type; null = no cap

  // Eligibility
  min_order_amount     Decimal    @default(0) @db.Decimal(10, 2)
  max_uses_total       Int?                               // null = unlimited
  max_uses_per_user    Int?       @default(1)              // null = unlimited per user

  // Validity
  valid_from           DateTime   @db.Timestamptz(6)
  valid_until          DateTime?  @db.Timestamptz(6)      // null = never expires
  is_active            Boolean    @default(true)

  // Denormalized counter
  total_used           Int        @default(0)

  // Audit
  created_by_cadmin_id String?    @db.Uuid
  created_by_name      String?    @db.VarChar(100)
  created_at           DateTime   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime   @updatedAt @db.Timestamptz(6)

  usages               CouponUsage[]

  @@index([code])
  @@index([is_active, valid_from, valid_until])
  @@map("coupons")
}

model CouponUsage {
  usage_id        String    @id @default(uuid()) @db.Uuid
  coupon_id       String    @db.Uuid
  customer_id     String    @db.Uuid
  order_id        String    @db.Uuid
  discount_amount Decimal   @db.Decimal(10, 2)
  used_at         DateTime  @default(now()) @db.Timestamptz(6)

  coupon          Coupon           @relation(fields: [coupon_id], references: [coupon_id], onDelete: Restrict)
  customer        CureliMobileUser @relation("CustomerCouponUsages", fields: [customer_id], references: [id], onDelete: Restrict)
  order           MarketplaceOrder @relation("OrderCouponUsages", fields: [order_id], references: [order_id], onDelete: Restrict)

  @@unique([coupon_id, order_id])
  @@index([coupon_id])
  @@index([customer_id, coupon_id])
  @@index([order_id])
  @@map("coupon_usages")
}
