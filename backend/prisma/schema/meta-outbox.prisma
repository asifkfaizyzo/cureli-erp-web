enum MetaOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  PERMANENT_FAILURE
}

model MetaOutboxEvent {
  id                    String           @id @default(uuid()) @db.Uuid
  event_id              String           @unique
  event_name            String
  event_time            Int
  event_data            Json             @default("{}")
  user_data             Json             @default("{}")
  status                MetaOutboxStatus @default(PENDING)
  attempts              Int              @default(0)
  last_error            String?          @db.Text
  next_retry_at         DateTime?
  claimed_at            DateTime?
  processing_expires_at DateTime?
  claimed_by            String?
  processed_at          DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  @@index([status, next_retry_at])
  @@index([status, processing_expires_at])
  @@map("meta_outbox_events")
}